# URL base del backend (Spring Boot). Incluye /api/v1.
# - Navegador / emulador Android: http://localhost:8080/api/v1
#   (en el emulador la app cambia "localhost" por 10.0.2.2 automáticamente)
# - Celular físico por USB (con "adb reverse tcp:8080 tcp:8080"): http://127.0.0.1:8080/api/v1
# - Celular físico en la misma red Wi-Fi: http://<IP-de-tu-PC>:8080/api/v1
VITE_API_URL=http://localhost:8080/api/v1

# IMPORTANTE: no pongas aquí la API key de Spoonacular. Todo lo que empieza con VITE_
# termina dentro de la app y cualquiera podría extraerlo. La key va en backend-core/.env
