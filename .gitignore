# VARIABLES DE ENTORNO (Secretos locales)
.env
.env.*
!.env.example

# BACKEND (Java, Spring Boot & Maven)
backend-core/target/
*.class
*.jar
*.war
*.ear
*.log
.mvn/*
!backend-core/.mvn/
backend-core/.mvn/*
!backend-core/.mvn/wrapper/
backend-core/.mvn/wrapper/*.jar

# FRONTEND (React, Vite & Node.js)
kukin-app/node_modules/
kukin-app/dist/
kukin-app/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SISTEMAS OPERATIVOS Y ARCHIVOS DE SISTEMA
desktop.ini
Thumbs.db
.DS_Store
.AppleDouble
.LSOverride

# ENTORNOS DE DESARROLLO (IDEs)
.vscode/
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# ANDROID (Capacitor) — el resto de reglas está en kukin-app/android/.gitignore
kukin-app/android/local.properties
*.apk
*.aab
*.keystore
*.jks
